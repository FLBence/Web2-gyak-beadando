<h2>Bejelentkezés</h2>

<form action="/login" method="POST">
    <div class="fields">
        <div class="field">
            <label>Felhasználónév</label>
            <input type="text" name="username" required />
        </div>
        <div class="field">
            <label>Jelszó</label>
            <input type="password" name="password" required />
        </div>
    </div>

    <ul class="actions">
        <li><input type="submit" value="Bejelentkezés" class="primary" /></li>
    </ul>
</form>
