<h2>Regisztráció</h2>

<form action="/register" method="POST">
    <div class="fields">
        <div class="field">
            <label>Felhasználónév</label>
            <input type="text" name="username" required />
        </div>
        <div class="field">
            <label>Jelszó</label>
            <input type="password" name="password" required />
        </div>
    </div>

    <ul class="actions">
        <li><input type="submit" value="Regisztráció" class="primary" /></li>
    </ul>
</form>
